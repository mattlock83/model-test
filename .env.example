# Live runs send browser accessibility evidence to the configured provider.
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-6-luna

# Optional: full endpoint implementing the OpenAI Decisions protocol.
# An ordinary chat-completions endpoint or native Jev endpoint needs an adapter.
# DECISION_ENDPOINT=https://your-provider.example/v1/decisions
# DECISION_API_KEY overrides OPENAI_API_KEY when set.
# DECISION_API_KEY=
# DECISION_MODEL overrides OPENAI_DECISION_MODEL when set.
# DECISION_MODEL=your-decision-model

# Optional: use another installed Chromium executable.
# PLAYWRIGHT_EXECUTABLE_PATH=/path/to/chrome
