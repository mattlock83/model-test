{
  "models": [
    {
      "id": "studio enquiries",
      "name": "Studio enquiries",
      "startElementId": "compose",
      "generator": "quick_random(edge_coverage(100))",
      "vertices": [
        {
          "id": "compose",
          "name": "compose",
          "properties": {
            "business": {
              "description": "A visitor is composing an enquiry with no validation problems displayed.",
              "rules": [
                "A visitor can provide an enquiry subject and message."
              ]
            }
          }
        },
        {
          "id": "needs_correction",
          "name": "needs_correction",
          "properties": {
            "business": {
              "description": "An enquiry submission has been rejected and validation problems are displayed.",
              "rules": [
                "The visitor can correct the enquiry.",
                "No successful receipt is claimed."
              ]
            }
          }
        },
        {
          "id": "received",
          "name": "received",
          "properties": {
            "business": {
              "description": "The studio acknowledges receiving the enquiry.",
              "rules": [
                "The acknowledgement refers to the submitted subject.",
                "The visitor can begin another enquiry."
              ]
            }
          }
        }
      ],
      "edges": [
        {
          "id": "send_enquiry",
          "name": "send_enquiry",
          "sourceVertexId": "compose",
          "targetVertexId": "received",
          "properties": {
            "business": {
              "intent": "Send the supplied enquiry to the studio. Stop after the first acceptance or rejection.",
              "data set": "Enquiry",
              "rejected at": "needs_correction"
            }
          }
        },
        {
          "id": "send_incomplete_enquiry",
          "name": "send_incomplete_enquiry",
          "sourceVertexId": "compose",
          "targetVertexId": "needs_correction",
          "properties": {
            "business": {
              "intent": "Send the supplied enquiry to the studio. Stop after the first acceptance or rejection.",
              "data set": "Enquiry",
              "accepted at": "received",
              "rejected at": "needs_correction",
              "example": {
                "Enquiry subject": "x",
                "Enquiry message": ""
              }
            }
          }
        },
        {
          "id": "restart_rejected_enquiry",
          "name": "restart_rejected_enquiry",
          "sourceVertexId": "needs_correction",
          "targetVertexId": "compose",
          "properties": {
            "business": {
              "intent": "Discard the rejected enquiry and start with an empty enquiry."
            }
          }
        },
        {
          "id": "another_enquiry",
          "name": "another_enquiry",
          "sourceVertexId": "received",
          "targetVertexId": "compose",
          "properties": {
            "business": {
              "intent": "Begin a new enquiry."
            }
          }
        }
      ],
      "properties": {
        "business": {
          "version": 3,
          "purpose": "Visitors can send enquiries to the studio.",
          "entry path": "/feedback.html",
          "rules": [
            "Visitors can send enquiries to the studio.",
            "An enquiry subject must contain 4 to 50 characters.",
            "An enquiry message must contain 5 to 200 characters.",
            "Invalid enquiries are rejected with useful explanations."
          ],
          "data sets": {
            "Enquiry": {
              "Enquiry subject": {
                "description": "The topic the visitor is contacting the studio about",
                "type": "text",
                "required": true,
                "minimum length": 4,
                "maximum length": 50,
                "example": "A small question"
              },
              "Enquiry message": {
                "description": "The content of the visitor enquiry",
                "type": "text",
                "required": true,
                "minimum length": 5,
                "maximum length": 200,
                "example": "When is the next session?"
              }
            }
          }
        }
      }
    }
  ]
}
